#!/usr/bin/env bash
# keel's supervisor (docs/plugins/07-step1-contract.md, section 8). In a loop:
#   1. resolve the plugins: keel-engine plugins resolve writes $KEEL_DATA/plugins/run/resolved.json and run/env
#      (KEEL_PLUGINS=on|image|off reaches it through the environment). If it fails, keel starts with no plugins.
#   2. start the engine with the plugin env (run/env), and wait for it
#   3. start the api with KEEL_SUPERVISED=1 and the plugin jars on loader.path, and wait for it
#   4. healthy: save the plugin set (names, versions) in $KEEL_DATA/plugins/last-good.json.
#      Not healthy in time, or the api stopped, and the set differs from last-good.json: stop both and start again
#      with only the last good plugins (--only last-good.json).
#   5. wait. Exit code 75 (the api asks for a restart, for example after a plugin install): stop both, back to 1.
#      Any other exit stops both and the container, as before.
# 0.24.0 the Python api (api-py/, `keel-api`) stands in front: it answers on KEEL_PORT, after the Kotlin api is healthy,
# and passes every route it does not answer yet to the Kotlin api, which then listens on 127.0.0.1:KEEL_BACK_PORT
# (8081) only (docs/plans/python-api.md). KEEL_FRONT: auto (the default: on when keel-api is installed), 1, or 0 (the
# Kotlin api alone on KEEL_PORT, as before). Exit code 75 from either api restarts them all.
#
# Tests (docker/tests/keel-start.test.sh) set the commands, health urls and timeouts through the environment:
# KEEL_RESOLVE_CMD, KEEL_ENGINE_CMD, KEEL_API_CMD, KEEL_ENGINE_HEALTH_URL, KEEL_API_HEALTH_URL,
# KEEL_ENGINE_START_TIMEOUT (30 s), KEEL_API_START_TIMEOUT (90 s), KEEL_STOP_TIMEOUT (20 s), KEEL_START_POLL (0.5 s);
# the Python api: KEEL_FRONT, KEEL_FRONT_CMD, KEEL_BACK_HEALTH_URL, KEEL_FRONT_START_TIMEOUT (30 s).
#
# v0.16.1 native mode (keel2 start --native) runs this same loop: docker/keel-native-start sets KEEL_NATIVE=1 and the
# release's own files (KEEL_ENGINE_EXE, KEEL_API_JAR, KEEL_PYTHON, KEEL_PLUGINS_IMAGE: paths may hold spaces) and the
# ports (KEEL_ENGINE_PORT, KEEL_PORT), then sources this file. Native mode never writes into $HOME and does not use a
# Docker socket's container settings.
set -euo pipefail

# 0.20.0 glibc keeps one malloc arena per thread up to 8 x CPUs: two are enough here and hold far less memory
export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX:-2}"
export KEEL_INTERNAL_TOKEN="${KEEL_INTERNAL_TOKEN:-$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')}"
mkdir -p "$KEEL_DATA"
# v0.16.1 keel2 mcp (docker exec) reads it from here to ask the api for its MCP level token (KEEL_INTERNAL_TOKEN_FILE)
mkdir -p "$KEEL_DATA/run"
(umask 077; printf '%s' "$KEEL_INTERNAL_TOKEN" > "$KEEL_DATA/run/internal-token")

# keel 0.21.3 the agents' own user (engine/keel_engine/tools/agent_user.py, Dockerfile): the agent CLIs and every
# command keel runs for a project start as KEEL_AGENT_USER (`agent`), through sudo and keel-as-agent. It works only when
# the sudo rule does; else agents run as keel's own user, as before, and the log says so. Native mode (keel2 start
# --native) never has a second user: agents run as the person there, as before.
AGENT_USER=""
if [ -n "${KEEL_AGENT_USER:-}" ] && [ "${KEEL_NATIVE:-0}" != 1 ]; then
  if id "$KEEL_AGENT_USER" > /dev/null 2>&1 && [ "$(id -u "$KEEL_AGENT_USER")" != "$(id -u)" ] \
      && sudo -n -E -u "$KEEL_AGENT_USER" -- /usr/local/bin/keel-as-agent true > /dev/null 2>&1; then
    AGENT_USER=$KEEL_AGENT_USER
  else
    echo "agents: the user $KEEL_AGENT_USER does not work here (sudo rule?), so agents run as keel's own user"
  fi
fi
if [ -n "$AGENT_USER" ]; then export KEEL_AGENT_USER="$AGENT_USER"; else unset KEEL_AGENT_USER; fi

# lock_data: keel's own files are keel's only; the agents' user (in keel's group) may pass through $KEEL_DATA (0710:
# it cannot list it) into the folders it works in: the CLIs' homes, the code index and the demo project. Run at every
# start of the loop: a plugin install (exit 75) adds folders to plugins/store.
lock_data() {
  [ -n "$AGENT_USER" ] || return 0
  chmod 0710 "$KEEL_DATA" 2> /dev/null || true
  chmod 0700 "$HOME" 2> /dev/null || true
  local f name
  for f in "$KEEL_DATA"/* "$KEEL_DATA"/.[!.]*; do
    [ -e "$f" ] && [ ! -L "$f" ] || continue
    name=${f##*/}
    case "$name" in
      agent-home | codex-home | index | demo)
        chmod -R g+rwX,o-rwx "$f" 2> /dev/null || true ;;
      plugins)
        # the plugins' code is read by keel's MCP server, which an agent CLI starts; nothing else of keel's there
        chmod 0710 "$f"
        local g
        for g in "$f"/* "$f"/.[!.]*; do
          [ -e "$g" ] && [ ! -L "$g" ] || continue
          if [ "$g" = "$f/store" ]; then chmod -R g+rX,g-w,o-rwx "$g" 2> /dev/null || true; else chmod -R go-rwx "$g" 2> /dev/null || true; fi
        done ;;
      *)
        chmod go-rwx "$f" 2> /dev/null || true ;;
    esac
  done
  chmod 0700 "$KEEL_DATA/run" && chmod 0600 "$KEEL_DATA/run/internal-token"
}

if [ -n "$AGENT_USER" ]; then
  # everything keel's api and engine write from here on is their own (0600, 0700); the engine shares the project
  # folders with the agents itself (tools/agent_user.py share), and git keeps .git group-readable (sharedRepository)
  umask 077
  agent_home=$(getent passwd "$AGENT_USER" | cut -d: -f6)
  if [ -n "$agent_home" ] && [ -d "$agent_home" ] && [ ! -f "$agent_home/.claude.json" ]; then
    echo '{"hasCompletedOnboarding": true}' > "$agent_home/.claude.json" && chmod 0660 "$agent_home/.claude.json" || true
  fi
  # keel2 --docker: the project's tests (the agents' user) use the host's Docker as before. Docker reaches everything
  # of the host, keel's data volume too: with the socket, the separate user does not keep an agent from keel's files.
  if [ -S /var/run/docker.sock ]; then
    sudo -n /usr/local/bin/keel-stack-setup agent-docker || echo "agents: could not give $AGENT_USER the Docker socket"
    # #100 say whether the agents really reach Docker, not only that the socket is there (on Docker Desktop they did not)
    if out=$(sudo -n -E -u "$AGENT_USER" -- /usr/local/bin/keel-as-agent docker version --format '{{.Server.Version}}' 2>&1); then
      echo "agents: Docker works for $AGENT_USER (host engine $out)"
    else
      echo "agents: Docker does NOT work for $AGENT_USER: $(printf '%s' "$out" | tail -n 1)"
    fi
  fi
  echo "agents: run as the user $AGENT_USER (uid $(id -u "$AGENT_USER")), not as keel"
fi

# Claude Code asks for onboarding on a fresh home; headless runs only need this flag. (Native mode: the agent CLIs get
# their own home under $KEEL_DATA, engine models/cli.py; the person's own home is never written.)
if [ "${KEEL_NATIVE:-0}" != 1 ]; then
  [ -f "$HOME/.claude.json" ] || echo '{"hasCompletedOnboarding": true}' > "$HOME/.claude.json"
fi

# Host Docker (keel2 --docker): tests inside reach the containers they start through the host.
if [ "${KEEL_NATIVE:-0}" != 1 ] && [ -S /var/run/docker.sock ]; then
  export TESTCONTAINERS_HOST_OVERRIDE="${TESTCONTAINERS_HOST_OVERRIDE:-host.docker.internal}"
  docker version --format 'docker: client {{.Client.Version}}, host engine {{.Server.Version}}' 2>/dev/null || echo "docker: socket mounted but not usable (permissions?)"
fi

echo "keel v2 · data $KEEL_DATA · workspace $KEEL_WORKSPACE · content $KEEL_CONTENT · plugins ${KEEL_PLUGINS:-on}"

RUN="$KEEL_DATA/plugins/run"
LAST_GOOD="$KEEL_DATA/plugins/last-good.json"
ENGINE_EXE="${KEEL_ENGINE_EXE:-keel-engine}"      # one program (a path with spaces is fine)
RESOLVE_CMD="${KEEL_RESOLVE_CMD:-}"                 # tests: words, run as they are
ENGINE_CMD="${KEEL_ENGINE_CMD:-}"
API_JAR="${KEEL_API_JAR:-/opt/api/app.jar}"
PYTHON="${KEEL_PYTHON:-python3}"
ENGINE_PORT="${KEEL_ENGINE_PORT:-8090}"
API_PORT="${KEEL_PORT:-8080}"
ENGINE_HEALTH="${KEEL_ENGINE_HEALTH_URL:-http://127.0.0.1:$ENGINE_PORT/health}"
API_HEALTH="${KEEL_API_HEALTH_URL:-http://127.0.0.1:$API_PORT/api/health}"
ENGINE_TIMEOUT="${KEEL_ENGINE_START_TIMEOUT:-30}"
API_TIMEOUT="${KEEL_API_START_TIMEOUT:-90}"
STOP_TIMEOUT="${KEEL_STOP_TIMEOUT:-20}"
POLL="${KEEL_START_POLL:-0.5}"
FRONT_EXE="${KEEL_FRONT_EXE:-keel-api}"
FRONT_CMD="${KEEL_FRONT_CMD:-}"
BACK_PORT="${KEEL_BACK_PORT:-8081}"
FRONT_TIMEOUT="${KEEL_FRONT_START_TIMEOUT:-30}"
case "${KEEL_FRONT:-auto}" in
  1 | on) FRONT_ON=1 ;;
  0 | off) FRONT_ON=0 ;;
  *) if [ -n "$FRONT_CMD" ] || command -v "$FRONT_EXE" > /dev/null 2>&1; then FRONT_ON=1; else FRONT_ON=0; fi ;;
esac
# the Kotlin api's own health: behind the Python api it answers on 127.0.0.1:BACK_PORT, else on KEEL_PORT
if [ "$FRONT_ON" = 1 ]; then BACK_HEALTH="${KEEL_BACK_HEALTH_URL:-http://127.0.0.1:$BACK_PORT/api/health}"; else BACK_HEALTH="$API_HEALTH"; fi
engine="" api="" front="" resolved=0

# ---------------------------------------------------------------- plugins

# resolve [--only <file>]: runs the resolver; resolved=1 when it worked
resolve() {
  mkdir -p "$RUN"
  resolved=0
  # shellcheck disable=SC2086  # the command is words on purpose (tests give their own)
  local code=0
  if [ -n "$RESOLVE_CMD" ]; then $RESOLVE_CMD "$@" || code=$?; else "$ENGINE_EXE" plugins resolve "$@" || code=$?; fi
  if [ "$code" = 0 ]; then resolved=1; else no_plugins "the resolver failed (exit $code)"; fi
}

# no_plugins <why>: start with no plugins at all. The api then finds no resolved.json, so it has none either.
no_plugins() {
  echo "plugins: $1, so keel starts with no plugins"
  rm -f "$RUN/resolved.json" "$RUN/env"
  resolved=0
}

# load_env: KEEL_PLUGIN_PATHS, KEEL_PLUGIN_ADDONS and KEEL_PLUGIN_LOADER_PATH from run/env (empty without plugins)
load_env() {
  KEEL_PLUGIN_PATHS="" KEEL_PLUGIN_ADDONS="" KEEL_PLUGIN_LOADER_PATH=""
  if [ "$resolved" = 1 ] && [ -f "$RUN/env" ]; then
    # shellcheck source=/dev/null
    if (. "$RUN/env") > /dev/null 2>&1; then . "$RUN/env"; else no_plugins "$RUN/env does not read"; fi
  fi
  export KEEL_PLUGIN_PATHS KEEL_PLUGIN_ADDONS KEEL_PLUGIN_LOADER_PATH
}

# plugin_set <json file>: one "name version" line per plugin, sorted; nothing when the file is missing or broken
plugin_set() {
  [ -f "$1" ] || return 0
  "$PYTHON" -I -c 'import json, sys
for p in sorted(json.load(open(sys.argv[1])).get("plugins") or [], key=lambda p: p["name"]):
    print(p["name"], p["version"])' "$1" 2>/dev/null || true
}

# save_last_good: the plugins of this healthy start, for the next start that fails
save_last_good() {
  "$PYTHON" -I - "$RUN/resolved.json" "$LAST_GOOD" << 'EOF' || echo "plugins: could not write $LAST_GOOD"
import datetime, json, os, sys
src, dst = sys.argv[1], sys.argv[2]
plugins = [{"name": p["name"], "version": p["version"]} for p in json.load(open(src)).get("plugins") or []]
now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
with open(dst + ".tmp", "w") as f:
    json.dump({"saved_at": now, "plugins": plugins}, f, indent=2)
    f.write("\n")
os.replace(dst + ".tmp", dst)
EOF
}

# ---------------------------------------------------------------- processes

start_engine() {
  # shellcheck disable=SC2086
  if [ -n "$ENGINE_CMD" ]; then
    KEEL_ENGINE_HOST=127.0.0.1 KEEL_ENGINE_PORT="$ENGINE_PORT" $ENGINE_CMD &
  else
    KEEL_ENGINE_HOST=127.0.0.1 KEEL_ENGINE_PORT="$ENGINE_PORT" "$ENGINE_EXE" &
  fi
  engine=$!
}

start_api() {
  # behind the Python api, the Kotlin api listens on 127.0.0.1:BACK_PORT only
  local back=(KEEL_SUPERVISED=1)
  if [ "$FRONT_ON" = 1 ]; then back+=(KEEL_PORT="$BACK_PORT" SERVER_ADDRESS=127.0.0.1); fi
  if [ -n "${KEEL_API_CMD:-}" ]; then
    # shellcheck disable=SC2086
    env "${back[@]}" $KEEL_API_CMD &
  else
    # keel's plain jar; PropertiesLauncher adds the plugin jars (loader.path) and finds Start-Class by itself.
    # The heap: a quarter of the container's memory, not 60%. The api uses 70-300 MB; 60% of Docker Desktop's VM
    # (4.6 GB of 7.6 GB) let each keel's heap grow, and the projects' own builds and tests run in the same VM. Serial
    # GC: one GC thread instead of one per CPU (9 on an 11-core Mac), the smallest footprint for a heap this size.
    # 0.20.0 C1 only: the api waits on the engine and the database, C2's compiler threads cost more CPU and memory at start
    # than they ever give back; a smaller thread stack (40 threads at idle).
    # The api's settings come from the jar and the environment only: no application.* or loader.properties from the
    # folder it starts in (the project folder in the image, any folder in native mode).
    # #99 -XX:+PerfDisableSharedMem always, also with the person's JAVA_OPTS: the JVM's counters stay in memory, not in a
    # file it maps from /tmp (hsperfdata). When the disk filled, reading that file killed the api with SIGBUS, and with
    # it every open keel2 mcp session; now a full disk is an error the api answers, not its end.
    # shellcheck disable=SC2086  # JAVA_OPTS holds several options
    env "${back[@]}" java -XX:+PerfDisableSharedMem ${JAVA_OPTS:--XX:MaxRAMPercentage=25 -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xss512k} -Dloader.path="$KEEL_PLUGIN_LOADER_PATH" \
      -Dloader.home="$(dirname "$API_JAR")" -Dspring.config.location=optional:classpath:/,optional:classpath:/config/ \
      -cp "$API_JAR" org.springframework.boot.loader.launch.PropertiesLauncher &
  fi
  api=$!
}

start_front() {
  local env=(KEEL_SUPERVISED=1 KEEL_PORT="$API_PORT" KEEL_BACK_URL="http://127.0.0.1:$BACK_PORT")
  # shellcheck disable=SC2086
  if [ -n "$FRONT_CMD" ]; then env "${env[@]}" $FRONT_CMD & else env "${env[@]}" "$FRONT_EXE" & fi
  front=$!
}

healthy() { curl -fs --max-time 5 "$1" > /dev/null 2>&1; }

# wait_up <pid> <url> <seconds>: 0 healthy, 1 not healthy in time, 2 the process stopped
wait_up() {
  local end=$((SECONDS + $3))
  while :; do
    healthy "$2" && return 0
    kill -0 "$1" 2>/dev/null || return 2
    [ "$SECONDS" -lt "$end" ] || return 1
    sleep "$POLL"
  done
}

all_running() {
  local pid
  for pid in $engine $api $front; do kill -0 "$pid" 2>/dev/null || return 1; done
}

# wait_any: waits until the engine or an api stops, and returns its exit code
wait_any() {
  if ((BASH_VERSINFO[0] * 100 + BASH_VERSINFO[1] >= 501)) && all_running; then
    # shellcheck disable=SC2086  # front is empty without the Python api
    wait -n $engine $api $front
  else
    # one has stopped already, or bash is older than 5.1 (no wait -n for given ids; macOS runs the tests with
    # bash 3.2): look every POLL seconds
    while all_running; do sleep "$POLL"; done
    local pid
    for pid in $front $api $engine; do
      if ! kill -0 "$pid" 2>/dev/null; then wait "$pid"; return; fi
    done
  fi
}

# stop_both: TERM to the apis and the engine, KILL after KEEL_STOP_TIMEOUT seconds, and wait for them
stop_both() {
  local pid end=$((SECONDS + STOP_TIMEOUT))
  for pid in $front $api $engine; do kill -TERM "$pid" 2>/dev/null || true; done
  for pid in $front $api $engine; do
    while kill -0 "$pid" 2>/dev/null && [ "$SECONDS" -lt "$end" ]; do sleep "$POLL"; done
    kill -KILL "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  done
  engine="" api="" front=""
}

trap 'stop_both; exit 143' TERM
trap 'stop_both; exit 130' INT

# ---------------------------------------------------------------- the loop
fallback=0
while :; do
  lock_data
  if [ "$fallback" = 1 ]; then resolve --only "$LAST_GOOD"; else resolve; fi
  load_env
  plugins="$(plugin_set "$RUN/resolved.json")"
  echo "plugins: $(printf '%s' "${plugins:-none}" | tr '\n' ',' | sed 's/,/, /g')"

  start_engine
  up=0
  wait_up "$engine" "$ENGINE_HEALTH" "$ENGINE_TIMEOUT" || up=$?
  if [ "$up" = 2 ]; then
    echo "engine failed to start"
    stop_both
    exit 1
  fi
  [ "$up" = 0 ] || echo "the engine is not healthy after ${ENGINE_TIMEOUT}s; starting the api anyway"

  start_api
  echo "keel v2 is starting on http://localhost:$API_PORT"
  up=0
  wait_up "$api" "$BACK_HEALTH" "$API_TIMEOUT" || up=$?
  if [ "$up" = 0 ] && [ "$FRONT_ON" = 1 ]; then
    start_front
    wait_up "$front" "$API_HEALTH" "$FRONT_TIMEOUT" || up=$?
    if [ "$up" = 2 ] && ! kill -0 "$front" 2>/dev/null; then
      code=0
      wait "$front" || code=$?
      echo "the Python api stopped before it was healthy (exit $code)"
      stop_both
      exit "$code"
    fi
  fi
  if [ "$up" = 0 ]; then
    if [ "$resolved" = 1 ]; then save_last_good; fi
  elif [ "$fallback" = 0 ] && [ -f "$LAST_GOOD" ] && [ "$plugins" != "$(plugin_set "$LAST_GOOD")" ]; then
    # a new plugin can break the api's start (a bad jar): try once more with the plugins that worked last time
    echo "keel did not start with these plugins: starting again with the last good ones ($LAST_GOOD)"
    stop_both
    fallback=1
    continue
  elif [ "$up" = 2 ]; then
    code=0
    wait "$api" || code=$?
    echo "the api stopped before it was healthy (exit $code)"
    stop_both
    exit "$code"
  else
    echo "the api is not healthy after ${API_TIMEOUT}s; waiting for it"
  fi
  fallback=0

  code=0
  wait_any || code=$?
  stop_both
  if [ "$code" = 75 ]; then
    echo "keel restarts (exit 75): resolving the plugins again"
    continue
  fi
  exit "$code"
done
