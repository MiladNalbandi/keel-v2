#!/usr/bin/env bash
# keel v2 native mode (keel2 start --native): the engine and the api on this computer, no Docker. The same start as
# docker/keel-start (it runs that file's loop: the plugins resolved at every start, a restart on exit 75, the last good
# plugins when a start fails), minus what only makes sense in a container: it never writes into $HOME (the agent CLIs
# get their own home under $KEEL_DATA, engine models/cli.py) and it does not look for a Docker socket.
#
#   KEEL_APP   the unpacked release (api.jar, engine/.venv, content/, plugins/, keel-start)      set by keel2
#   KEEL_DATA, KEEL_WORKSPACE, KEEL_FOLDERS, KEEL_PORT, KEEL_ENGINE_PORT                         set by keel2
#   KEEL_PLUGINS (on | image | off)                                                              keel2 --safe: image
#   KEEL_BACK_PORT   the Kotlin api's port behind the Python api (default 8081)                  set by keel2
#   KEEL_ENGINE_EXE, KEEL_PYTHON, KEEL_MCP_PYTHON, KEEL_API_JAR, KEEL_FRONT_EXE, KEEL_JAVA       the desktop app (desktop/)
set -euo pipefail

: "${KEEL_APP:?KEEL_APP is not set (keel2 start --native sets it)}"
: "${KEEL_DATA:?KEEL_DATA is not set}"
# 0.41.2 a keel2 script before 0.41.2 (keel2 update keeps the script) still passes the token as KEEL_INTERNAL_TOKEN: this
# process lives as long as keel, and its environment (`ps eww`) would keep it. Into the file, then start again without it.
if [ -n "${KEEL_INTERNAL_TOKEN:-}" ]; then
  mkdir -p "$KEEL_DATA/run"
  (umask 077; printf '%s' "$KEEL_INTERNAL_TOKEN" > "$KEEL_DATA/run/internal-token.new" && mv -f "$KEEL_DATA/run/internal-token.new" "$KEEL_DATA/run/internal-token")
  exec env -u KEEL_INTERNAL_TOKEN KEEL_INTERNAL_TOKEN_FILE="$KEEL_DATA/run/internal-token" /bin/bash "$0" "$@"
fi
export KEEL_NATIVE=1
export KEEL_CONTENT="${KEEL_CONTENT:-$KEEL_APP/content}"
export KEEL_PORT="${KEEL_PORT:-8080}"
# 127.0.0.1 only, unless keel2 start --native --wifi asked for the network (KEEL_BIND): every call needs a sign-in (api LocalAuth)
export SERVER_ADDRESS="${KEEL_BIND:-127.0.0.1}"
export KEEL_ENGINE_PORT="${KEEL_ENGINE_PORT:-8090}"
export KEEL_ENGINE_URL="http://127.0.0.1:$KEEL_ENGINE_PORT"
export KEEL_API_URL="http://127.0.0.1:$KEEL_PORT"
# the internal token: keel-start (KEEL_INTERNAL_TOKEN_FILE from keel2 or the desktop app, never a variable)
export CODEGRAPH_NO_DAEMON=1 CODEGRAPH_TELEMETRY=0 DO_NOT_TRACK=1 CODEGRAPH_NO_UPDATE_CHECK=1
# the plugins that came in the release (as /opt/keel-v2/plugins in the image), with the installed ones in $KEEL_DATA
export KEEL_PLUGINS_IMAGE="${KEEL_PLUGINS_IMAGE:-$KEEL_APP/plugins}"
# keel-start's commands: the release's own engine, api and Python (keel2 installs them into engine/.venv). 0.27.0 the
# keel desktop app sets its own (a Python and a Java inside the app, desktop/): these are only the defaults.
export KEEL_ENGINE_EXE="${KEEL_ENGINE_EXE:-$KEEL_APP/engine/.venv/bin/keel-engine}"
export KEEL_API_JAR="${KEEL_API_JAR:-$KEEL_APP/api.jar}"
export KEEL_PYTHON="${KEEL_PYTHON:-$KEEL_APP/engine/.venv/bin/python}"
export KEEL_MCP_PYTHON="${KEEL_MCP_PYTHON:-$KEEL_PYTHON}"
# 0.27.0 the Python api in front of the Kotlin api, as in the image (docker/keel-start, KEEL_FRONT): the release's own
# keel-api (keel2 installs it into api-py/.venv). The Kotlin api then listens on 127.0.0.1:KEEL_BACK_PORT.
if [ -z "${KEEL_FRONT_EXE:-}" ] && [ -x "$KEEL_APP/api-py/.venv/bin/keel-api" ]; then
  export KEEL_FRONT_EXE="$KEEL_APP/api-py/.venv/bin/keel-api"
fi
export JAVA_OPTS="${JAVA_OPTS:--Xmx1g}"
# keel's own agent CLIs and codegraph first (keel2 installs them with npm --prefix), then the person's PATH
if [ -n "${KEEL_NPM:-}" ]; then
  export PATH="$KEEL_NPM/bin:$PATH"
  [ -x "$KEEL_NPM/bin/codegraph" ] && export KEEL_CODEGRAPH_BIN="$KEEL_NPM/bin/codegraph"
fi
mkdir -p "$KEEL_DATA"

echo "keel v2 (native) · data $KEEL_DATA · workspace ${KEEL_WORKSPACE:-} · content $KEEL_CONTENT"

# keel-start's loop, in this process (keel2 knows a native keel by this script's name in its pid's command line)
# shellcheck source=keel-start
. "$KEEL_APP/keel-start"
