    "nodes": [
     {
      "step": "plan_gate",
      "side": []
     }
    ]
   },
   {
    "kind": "phase",
    "phase": "ac",
    "nodes": [
     {
      "step": "build",
      "side": []
     },
     {
      "step": "check",
      "side": []
     },
     {
      "step": "done_show",
      "side": []
     }
    ]
   },
   {
    "kind": "phase",
    "phase": "gate",
    "nodes": [
     {
      "step": "done_gate",
      "side": []
     }
    ]
   },
   {
    "kind": "phase",
    "phase": "ac",
    "nodes": [
     {
      "step": "commit",
      "side": []
     }
    ]
   },
   {
    "kind": "phase",
    "phase": "close",
    "nodes": [
     {
      "step": "pr",
      "side": []
     },
     {
      "step": "pr_gate",
      "side": []
     },
     {
      "step": "open_pr",
      "side": []
