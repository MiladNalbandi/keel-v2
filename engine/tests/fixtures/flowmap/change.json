{
 "workflow": "change",
 "name": "change (keel)",
 "steps": [
  {
   "id": "triage",
   "kind": "agent",
   "name": "triage",
   "agent": "explorer",
   "model": "default",
   "phase": "triage",
   "markers": [
    "SIZE"
   ],
   "instructions": "Triage this change with one question: could a test notice a difference? No \u2192 trivial (refactor, rename, formatting, docs, a dependency bump with no effect, a UI typo): write no criteria. Yes \u2192 does it touch the contract, a migration or auth, need more than three criteria, or rest on details of a third-party API, webhook or library that this repository does not hold (field names, payload formats, limits)? Then it is a feature (0.18.21: the feature flow researches them on the web before its spec). Otherwise it is small: one to three criteria. A trivial change may add new test files but never edit an existing test, so a change that must edit one (a rename the tests call, say) is small, not trivial. Say the size, the reason and the files you expect to touch. SIZE is trivial, small or feature."
  },
  {
   "id": "size",
   "kind": "code",
   "name": "size + criteria",
   "phase": "triage",
   "action": "change_size"
  },
  {
   "id": "scope_gate",
   "kind": "gate",
   "name": "scope check",
   "phase": "small-change",
   "back": "triage",
   "lock": true,
   "recommend": "SIZE",
   "choices": [
    "small",
    "trivial",
    "feature"
   ]
  },
  {
   "id": "is_feature",
   "kind": "branch",
   "name": "escalate to a feature",
   "phase": "small-change",
   "no": "is_trivial",
   "when": {
    "marker": "CHOICE",
    "equals": "feature",
    "step": "scope_gate"
   }
  },
  {
   "id": "to_feature",
   "kind": "code",
   "name": "start the feature flow with the inline criteria",
   "phase": "small-change",
   "action": "start_flow",
   "flow": "feature",
   "seed": {
    "title": "$title",
    "acs": "$acs",
    "escalated_from": "change"
   },
   "then": "end"
  },
  {
   "id": "is_trivial",
   "kind": "branch",
   "name": "trivial",
   "phase": "small-change",
   "no": "small",
   "when": {
    "marker": "CHOICE",
    "equals": "trivial",
    "step": "scope_gate"
   }
  },
  {
   "id": "trivial",
   "kind": "agent",
   "name": "trivial change",
   "agent": "implementer",
   "model": "default",
   "phase": "trivial",
   "instructions": "Make the change. Nothing observable may change: do not touch existing tests, the contract or migrations. If the change needs an existing test edited, it is not trivial: stop and say so."
  },
  {
   "id": "trivial_commit",
   "kind": "code",
   "name": "verify + trivial commit",
   "phase": "trivial",
   "action": "verify_green+commit",
   "lock": true,
   "then": "ship_plan",
   "rounds": 2,
   "after_rounds": "not_trivial"
  },
  {
   "id": "small",
   "kind": "code",
   "name": "small change",
   "phase": "small-change",
   "action": "change_start",
   "back": "triage",
   "rounds": 1
  },
  {
   "id": "red",
   "kind": "agent",
   "name": "red",
   "agent": "test-author",
   "model": "default",
   "phase": "red",
   "per_ac": true
  },
  {
   "id": "verify_red",
   "kind": "code",
   "name": "verify_red",
   "phase": "red",
   "action": "verify_red+commit",
   "per_ac": true,
   "lock": true
  },
  {
   "id": "green",
   "kind": "agent",
   "name": "green",
   "agent": "implementer",
   "model": "default",
   "phase": "green",
   "per_ac": true
  },
  {
   "id": "verify_green",
   "kind": "code",
   "name": "verify_green + commit",
   "phase": "green",
   "action": "verify_green+commit",
   "per_ac": true,
   "lock": true
  },
  {
   "id": "ac_suite",
   "kind": "code",
   "name": "the tests outside this criterion",
   "phase": "green",
   "action": "verify_after_green",
   "per_ac": true,
   "back": "green"
  },
  {
   "id": "ac_gate",
   "kind": "gate",
   "name": "AC gate",
   "phase": "gate",
   "per_ac": true,
   "back": "red",
   "lock": true
  },
  {
   "id": "ship_plan",
   "kind": "gate",
   "name": "which ship steps run",
   "phase": "ship",
   "lock": true,
   "skip_menu": true,
   "included_from": "ship"
  },
  {
   "id": "ship_doc_updates",
   "kind": "agent",
   "name": "docs the change makes wrong",
   "agent": "implementer",
   "model": "default",
   "phase": "close",
   "instructions": "This step is about the project's own docs, not code and not keel's knowledge base. Read the branch diff against the base branch, then the README, the CHANGELOG (when the project keeps one), the API docs (an OpenAPI description, docs/api, pages for the routes this branch adds or changes) and the user guide pages. Edit only what this change makes wrong or incomplete: a new or changed route, flag, config key, command or behaviour a reader would miss. A project with a CHANGELOG gets one entry under its unreleased heading. Touch no code, no test, no spec and nothing in the knowledge base; keep each edit small. When nothing is wrong, change nothing and say so. End with one line per file you changed and why: the final review shows it.",
   "skippable": "optional",
   "group": "doc_updates",
   "keep": true,
   "included_from": "ship"
  },
  {
   "id": "ship_doc_updates_commit",
   "kind": "code",
   "name": "commit the doc edits",
   "phase": "close",
   "action": "commit",
   "skippable": "optional",
   "group": "doc_updates",
   "included_from": "ship"
  },
  {
   "id": "ship_verify_fix",
   "kind": "agent",
   "name": "fix what the checks found",
   "agent": "implementer",
   "model": "default",
   "phase": "review-fix",
   "retry_only": true,
   "included_from": "ship"
  },
  {
   "id": "ship_verify_fix_commit",
   "kind": "code",
   "name": "commit the fix",
   "phase": "review-fix",
   "action": "commit",
   "included_from": "ship"
  },
  {
   "id": "ship_verify",
   "kind": "code",
   "name": "verify fast + module",
   "phase": "ship",
   "action": "verify_fast+verify_module",
   "lock": true,
   "rounds": 2,
   "included_from": "ship"
  },
  {
   "id": "ship_lint",
   "kind": "code",
   "name": "static checks",
   "phase": "ship",
   "action": "verify_lint",
   "soft": true,
   "skippable": "optional",
   "group": "lint",
   "included_from": "ship"
  },
  {
   "id": "ship_ci",
   "kind": "code",
   "name": "the project's CI jobs on CI's versions",
   "phase": "ship",
   "action": "ci_pipeline",
   "soft": true,
   "skippable": "optional",
   "group": "ci",
   "included_from": "ship"
  },
  {
   "id": "ship_release",
   "kind": "code",
   "name": "verify release",
   "phase": "ship",
   "action": "verify_release",
   "rounds": 2,
   "skippable": "deferred",
   "group": "release",
   "included_from": "ship"
  },
  {
   "id": "ship_cover_measure",
   "kind": "code",
   "name": "measure coverage",
   "phase": "coverage-fix",
   "action": "verify_coverage",
   "lock": true,
   "soft": true,
   "skippable": "deferred",
   "group": "cover",
   "included_from": "ship/cover"
  },
  {
   "id": "ship_cover_measured",
   "kind": "branch",
   "name": "the coverage command failed",
   "phase": "coverage-fix",
   "no": "ship_cover_needs_work",
   "when": {
    "data": "coverage_error"
   },
   "skippable": "deferred",
   "group": "cover",
   "included_from": "ship/cover"
  },
  {
   "id": "ship_cover_measure_failed",
   "kind": "gate",
   "name": "coverage could not be measured",
   "phase": "coverage-fix",
   "when": {
    "data": "coverage_error"
   },
   "skippable": "deferred",
   "group": "cover",
   "choices": {
    "try_again": "ship_cover_measure",
    "go_on": "ship_cover_report"
   },
   "included_from": "ship/cover"
  },
  {
   "id": "ship_cover_needs_work",
   "kind": "branch",
   "name": "coverage fails",
   "phase": "coverage-fix",
   "no": "ship_cover_report",
   "when": {
    "marker": "RESULT",
    "step": "ship_cover_measure",
    "equals": "fail"
   },
   "skippable": "deferred",
   "group": "cover",
   "included_from": "ship/cover"
  },
  {
   "id": "ship_cover_no_reports",
   "kind": "gate",
   "name": "cover needs coverage.reports",
   "phase": "coverage-fix",
   "when": {
    "data": "coverage_no_reports"
   },
   "skippable": "deferred",
   "group": "cover",
   "choices": {
    "go_on": "ship_cover_report",
    "stop": "end"
   },
   "included_from": "ship/cover"
  },
  {
   "id": "ship_cover_decide",
   "kind": "gate",
   "name": "decide test / delete / accept",
   "phase": "coverage-fix",
   "lock": true,
   "for_each": "coverage_groups",
   "per_item": true,
   "skippable": "deferred",
   "group": "cover",
   "choices": [
    "test",
    "delete",
    "accept"
   ],
   "on_skip": {
    "choice": "accept",
    "record": "coverage_accepted"
   },
   "included_from": "ship/cover"
  },
  {
   "id": "ship_cover_write",
   "kind": "agent",
   "name": "cover the group: write the test, or delete the unreachable lines",
   "agent": "test-author",
   "model": "default",
   "phase": "coverage-fix",
   "per_item": true,
   "skippable": "deferred",
   "group": "cover",
   "included_from": "ship/cover"
  },
  {
   "id": "ship_cover_review",
   "kind": "agent",
   "name": "review the coverage test: assertions lens",
   "agent": "lens-reviewer",
   "model": "default",
   "phase": "coverage-fix",
   "back": "ship_cover_write",
   "lock": true,
   "per_item": true,
   "instructions": "When the item's decision is delete: is the deleted code really unreachable? Look for callers, routes, reflection, configuration, scheduled jobs and event handlers that reach it; if anything can, that is blocking.",
   "rounds": 2,
   "skippable": "deferred",
   "group": "cover",
   "included_from": "ship/cover"
  },
  {
   "id": "ship_cover_commit",
   "kind": "code",
   "name": "coverage commit",
   "phase": "coverage-fix",
   "action": "commit",
   "back": "ship_cover_write",
   "lock": true,
   "per_item": true,
   "skippable": "deferred",
   "group": "cover",
   "included_from": "ship/cover"
  },
  {
   "id": "ship_cover_remeasure",
   "kind": "code",
   "name": "measure again",
   "phase": "coverage-fix",
   "action": "verify_coverage",
   "lock": true,
   "soft": true,
   "skippable": "deferred",
   "group": "cover",
   "included_from": "ship/cover"
  },
  {
   "id": "ship_cover_covered",
   "kind": "branch",
   "name": "coverage passes",
   "phase": "coverage-fix",
   "no": "ship_cover_decide",
   "when": {
    "marker": "RESULT",
    "step": "ship_cover_remeasure",
    "equals": "pass"
   },
   "rounds": 2,
   "skippable": "deferred",
   "group": "cover",
   "included_from": "ship/cover"
  },
  {
   "id": "ship_cover_report",
   "kind": "code",
   "name": "coverage verdict",
   "phase": "coverage-fix",
   "action": "coverage_report",
   "skippable": "deferred",
   "group": "cover",
   "included_from": "ship/cover"
  },
  {
   "id": "ship_deps",
   "kind": "code",
   "name": "verify deps",
   "phase": "ship",
   "action": "verify_deps",
   "skippable": "deferred",
   "group": "deps",
   "included_from": "ship"
  },
  {
   "id": "ship_audit",
   "kind": "code",
   "name": "audit",
   "phase": "ship",
   "action": "audit",
   "lock": true,
   "included_from": "ship"
  },
  {
   "id": "ship_trace",
   "kind": "code",
   "name": "trace --strict",
   "phase": "ship",
   "action": "trace_strict",
   "lock": true,
   "included_from": "ship"
  },
  {
   "id": "ship_lenses",
   "kind": "code",
   "name": "review lenses",
   "phase": "ship",
   "action": "review_lenses",
   "skippable": "optional",
   "group": "reviewers",
   "included_from": "ship"
  },
  {
   "id": "ship_review",
   "kind": "parallel",
   "name": "ship review, one lens each",
   "agent": "lens-reviewer",
   "model": "default",
   "phase": "ship",
   "from": "review_lenses",
   "rounds": 2,
   "redo": "ship_verify",
   "skippable": "optional",
   "group": "reviewers",
   "included_from": "ship"
  },
  {
   "id": "ship_spec_walk",
   "kind": "agent",
   "name": "walk the diff against the spec: name behaviour no criterion asks for",
   "agent": "lens-reviewer",
   "model": "default",
   "phase": "ship",
   "when": {
    "state": "spec"
   },
   "rounds": 2,
   "redo": "ship_verify",
   "skippable": "optional",
   "group": "spec_walk",
   "included_from": "ship"
  },
  {
   "id": "ship_final_review",
   "kind": "gate",
   "name": "final review",
   "phase": "final-review",
   "back": "ship_verify_fix",
   "lock": true,
   "report": "verdicts",
   "included_from": "ship"
  },
  {
   "id": "ship_memory_plan",
   "kind": "code",
   "name": "is the knowledge base stale?",
   "phase": "memory",
   "action": "memory_plan",
   "included_from": "ship"
  },
  {
   "id": "ship_memory_gate",
   "kind": "gate",
   "name": "update the knowledge base?",
   "phase": "memory",
   "when": {
    "data": "memory_plan.ask",
    "equals": "yes"
   },
   "choices": {
    "update": "ship_memory",
    "skip": "ship_memory_skip"
   },
   "included_from": "ship"
  },
  {
   "id": "ship_memory_skip",
   "kind": "code",
   "name": "skip the knowledge update",
   "phase": "memory",
   "action": "memory_skip",
   "when": {
    "data": "memory_plan.ask",
    "equals": "yes"
   },
   "then": "ship_memory_check",
   "included_from": "ship"
  },
  {
   "id": "ship_memory",
   "kind": "agent",
   "name": "knowledge update",
   "agent": "librarian",
   "model": "default",
   "phase": "memory",
   "when": {
    "data": "memory_plan.run",
    "equals": "yes"
   },
   "instructions": "Update only these sections, and in them only the claims that cite the files listed (they changed since the last knowledge check). Re-read those files, fix or remove what is no longer true, add what this branch makes worth knowing, and keep every other line as it is. A section listed as not written yet is written from the code.\n{{data.memory_plan.text}}",
   "included_from": "ship"
  },
  {
   "id": "ship_memory_check",
   "kind": "code",
   "name": "knowledge check",
   "phase": "memory",
   "action": "knowledge_check",
   "when": {
    "data": "memory_plan.check",
    "equals": "yes"
   },
   "included_from": "ship"
  },
  {
   "id": "ship_memory_commit",
   "kind": "code",
   "name": "commit memory",
   "phase": "memory",
   "action": "commit",
   "when": {
    "data": "memory_plan.run",
    "equals": "yes"
   },
   "included_from": "ship"
  },
  {
   "id": "ship_pr",
   "kind": "code",
   "name": "PR body",
   "phase": "close",
   "action": "pr",
   "included_from": "ship"
  },
  {
   "id": "ship_pr_gate",
   "kind": "gate",
   "name": "open the PR",
   "phase": "close",
   "lock": true,
   "included_from": "ship"
  },
  {
   "id": "ship_open_pr",
   "kind": "code",
   "name": "open the PR (never pushes)",
   "phase": "close",
   "action": "open_pr",
   "included_from": "ship"
  },
  {
   "id": "finish",
   "kind": "code",
   "name": "done",
   "phase": "close",
   "then": "end"
  },
  {
   "id": "not_trivial",
   "kind": "code",
   "name": "not trivial; put it back and triage again",
   "phase": "small-change",
   "action": "reset",
   "then": "triage"
  }
 ],
