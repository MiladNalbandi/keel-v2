{
 "workflow": "init",
 "name": "init (keel)",
 "steps": [
  {
   "id": "git_check",
   "kind": "code",
   "name": "is this a git repository",
   "phase": "setup",
   "action": "git_check"
  },
  {
   "id": "git_repo",
   "kind": "gate",
   "name": "not a git repository",
   "phase": "setup",
   "when": {
    "data": "git_question"
   },
   "choices": {
    "init": "git_init",
    "retry": "git_check",
    "go_on": "discover",
    "stop": "end"
   }
  },
  {
   "id": "git_init",
   "kind": "code",
   "name": "git init and the first commit",
   "phase": "setup",
   "action": "git_init"
  },
  {
   "id": "git_ready",
   "kind": "branch",
   "name": "a git repository with a commit",
   "phase": "setup",
   "no": "git_repo",
   "when": {
    "data": "git_ready"
   }
  },
  {
   "id": "discover",
   "kind": "agent",
   "name": "discover",
   "agent": "explorer",
   "model": "default",
   "phase": "setup",
   "instructions": "Map this project for keel's setup and for the librarians who write its knowledge base next: the backend and frontend (language, framework, build tool, their folders), the API contract if any, the compose file and its services with their ports, the names (never the values) of the environment variables the app reads, the test setup, and the main modules with the files that are their entry points (file:line). At most 60 lines, plain bullets, no prose; end the map with the line MAP-END. Change nothing.",
   "keep": true
  },
  {
   "id": "arch_detect",
   "kind": "code",
   "name": "detect the architecture",
   "phase": "setup",
   "action": "arch_detect"
  },
  {
   "id": "arch_survey",
   "kind": "parallel",
   "name": "arch-surveyor (low confidence only)",
   "agent": "arch-surveyor",
   "model": "default",
   "phase": "setup",
   "from": "arch_items",
   "cap": 1,
   "markers": [
    "ARCH"
   ]
  },
  {
   "id": "questions",
   "kind": "gate",
   "name": "questions",
   "phase": "setup",
   "back": "discover"
  },
  {
   "id": "plan_gate",
   "kind": "gate",
   "name": "setup plan",
   "phase": "setup",
   "back": "discover",
   "lock": true
  },
  {
   "id": "write_config",
   "kind": "code",
   "name": "write config",
   "phase": "setup",
   "action": "write_config",
   "lock": true
  },
  {
   "id": "arch_set",
   "kind": "code",
   "name": "record the architecture",
   "phase": "setup",
   "action": "arch_set"
  },
  {
   "id": "project_rules",
   "kind": "code",
   "name": "project rules and skills",
   "phase": "setup",
   "action": "project_rules"
  },
  {
   "id": "lanes",
   "kind": "parallel",
   "name": "ladder + knowledge",
   "phase": "setup",
   "parallel": 3,
   "lanes": [
    {
     "name": "ladder",
     "sub": "ladder_soft",
     "kind": "code"
    },
    {
     "name": "knowledge",
     "sub": "librarian",
     "kind": "agent"
    }
   ],
   "instructions": "The explorer's map of this project (where to start reading; check each claim in the code before you cite it, and read only what your section needs):\n{{data.discover_text}}"
  },
  {
   "id": "doctor",
   "kind": "parallel",
   "name": "setup-doctor for the failing rungs",
   "agent": "setup-doctor",
   "model": "default",
   "phase": "setup",
   "from": "doctor_items",
   "markers": [
    "DIAGNOSIS"
   ]
  },
  {
   "id": "rung_report",
   "kind": "code",
   "name": "the doctor's diagnosis",
   "phase": "setup",
   "action": "rung_report"
  },
  {
   "id": "rung_gate",
   "kind": "gate",
   "name": "a setup rung fails",
   "phase": "setup",
   "when": {
    "data": "rung_question"
   },
   "choices": {
    "apply_fix": "rung_apply",
    "retry": "rung_apply",
    "own_fix": "rung_apply",
    "skip": "rung_apply",
    "stop": "end"
   }
  },
  {
   "id": "rung_apply",
   "kind": "code",
   "name": "apply the rung decision",
   "phase": "setup",
   "action": "rung_apply"
  },
  {
   "id": "ladder_done",
   "kind": "branch",
   "name": "ladder green",
   "phase": "setup",
   "no": "doctor",
   "when": {
    "marker": "LADDER",
    "equals": "green"
   }
  },
  {
   "id": "memory_check",
   "kind": "code",
   "name": "knowledge check",
   "phase": "setup",
   "action": "knowledge_check"
  },
  {
   "id": "commit",
   "kind": "code",
   "name": "commit",
   "phase": "setup",
   "action": "commit",
   "lock": true
  },
  {
   "id": "summary",
   "kind": "code",
   "name": "hand-over summary",
   "phase": "setup",
   "action": "init_summary"
  },
  {
   "id": "audit_now",
   "kind": "gate",
   "name": "audit now",
   "phase": "setup",
   "choices": {
    "skip": "hand_over",
    "hunt": "start_hunt",
    "notes": "start_notes"
   }
  },
  {
   "id": "start_hunt",
   "kind": "code",
   "name": "start a bug hunt",
   "phase": "setup",
   "action": "start_flow",
   "flow": "hunt",
   "seed": {
    "title": "Bug hunt after init",
    "mode": "semi",
    "scope": "all"
   },
   "then": "end"
  },
  {
   "id": "start_notes",
   "kind": "code",
   "name": "build the project notes",
   "phase": "setup",
   "action": "start_flow",
   "flow": "knowledge-refresh",
   "seed": {
    "title": "Build the project notes"
   },
   "then": "end"
  },
  {
   "id": "hand_over",
   "kind": "gate",
   "name": "hand over",
   "phase": "setup"
  }
 ],
 "expect": {
  "main": [
   "git_check",
   "git_repo",
   "git_init",
   "git_ready",
   "discover",
   "arch_detect",
   "arch_survey",
   "questions",
   "plan_gate",
   "write_config",
   "arch_set",
   "project_rules",
   "lanes",
   "doctor",
   "rung_report",
   "rung_gate",
   "rung_apply",
   "ladder_done",
   "memory_check",
   "commit",
   "summary",
   "audit_now",
   "hand_over"
  ],
  "sections": [
   {
