{
 "workflow": "ship",
 "name": "ship (keel)",
 "steps": [
  {
   "id": "plan",
   "kind": "gate",
   "name": "which ship steps run",
   "phase": "ship",
   "lock": true,
   "skip_menu": true
  },
  {
   "id": "doc_updates",
   "kind": "agent",
   "name": "docs the change makes wrong",
   "agent": "implementer",
   "model": "default",
   "phase": "close",
   "instructions": "This step is about the project's own docs, not code and not keel's knowledge base. Read the branch diff against the base branch, then the README, the CHANGELOG (when the project keeps one), the API docs (an OpenAPI description, docs/api, pages for the routes this branch adds or changes) and the user guide pages. Edit only what this change makes wrong or incomplete: a new or changed route, flag, config key, command or behaviour a reader would miss. A project with a CHANGELOG gets one entry under its unreleased heading. Touch no code, no test, no spec and nothing in the knowledge base; keep each edit small. When nothing is wrong, change nothing and say so. End with one line per file you changed and why: the final review shows it.",
   "skippable": "optional",
   "keep": true
  },
  {
   "id": "doc_updates_commit",
   "kind": "code",
   "name": "commit the doc edits",
   "phase": "close",
   "action": "commit",
   "skippable": "optional",
   "group": "doc_updates"
  },
  {
   "id": "verify_fix",
   "kind": "agent",
   "name": "fix what the checks found",
   "agent": "implementer",
   "model": "default",
   "phase": "review-fix",
   "retry_only": true
  },
  {
   "id": "verify_fix_commit",
   "kind": "code",
   "name": "commit the fix",
   "phase": "review-fix",
   "action": "commit"
  },
  {
   "id": "verify",
   "kind": "code",
   "name": "verify fast + module",
   "phase": "ship",
   "action": "verify_fast+verify_module",
   "lock": true,
   "rounds": 2
  },
  {
   "id": "lint",
   "kind": "code",
   "name": "static checks",
   "phase": "ship",
   "action": "verify_lint",
   "soft": true,
   "skippable": "optional"
  },
  {
   "id": "ci",
   "kind": "code",
   "name": "the project's CI jobs on CI's versions",
   "phase": "ship",
   "action": "ci_pipeline",
   "soft": true,
   "skippable": "optional"
  },
  {
   "id": "release",
   "kind": "code",
   "name": "verify release",
   "phase": "ship",
   "action": "verify_release",
   "rounds": 2,
   "skippable": "deferred"
  },
  {
   "id": "cover_measure",
   "kind": "code",
   "name": "measure coverage",
   "phase": "coverage-fix",
   "action": "verify_coverage",
   "lock": true,
   "soft": true,
   "skippable": "deferred",
   "group": "cover",
   "included_from": "cover"
  },
  {
   "id": "cover_measured",
   "kind": "branch",
   "name": "the coverage command failed",
   "phase": "coverage-fix",
   "no": "cover_needs_work",
   "when": {
    "data": "coverage_error"
   },
   "skippable": "deferred",
   "group": "cover",
   "included_from": "cover"
  },
  {
   "id": "cover_measure_failed",
   "kind": "gate",
   "name": "coverage could not be measured",
   "phase": "coverage-fix",
   "when": {
    "data": "coverage_error"
   },
   "skippable": "deferred",
   "group": "cover",
   "choices": {
    "try_again": "cover_measure",
    "go_on": "cover_report"
   },
   "included_from": "cover"
  },
  {
   "id": "cover_needs_work",
   "kind": "branch",
   "name": "coverage fails",
   "phase": "coverage-fix",
   "no": "cover_report",
   "when": {
    "marker": "RESULT",
    "step": "cover_measure",
    "equals": "fail"
   },
   "skippable": "deferred",
   "group": "cover",
   "included_from": "cover"
  },
  {
   "id": "cover_no_reports",
   "kind": "gate",
   "name": "cover needs coverage.reports",
   "phase": "coverage-fix",
   "when": {
    "data": "coverage_no_reports"
   },
   "skippable": "deferred",
   "group": "cover",
   "choices": {
    "go_on": "cover_report",
    "stop": "end"
   },
   "included_from": "cover"
  },
  {
   "id": "cover_decide",
   "kind": "gate",
   "name": "decide test / delete / accept",
   "phase": "coverage-fix",
   "lock": true,
   "for_each": "coverage_groups",
   "per_item": true,
   "skippable": "deferred",
   "group": "cover",
   "choices": [
    "test",
    "delete",
    "accept"
   ],
   "on_skip": {
    "choice": "accept",
    "record": "coverage_accepted"
   },
   "included_from": "cover"
  },
  {
   "id": "cover_write",
   "kind": "agent",
   "name": "cover the group: write the test, or delete the unreachable lines",
   "agent": "test-author",
   "model": "default",
   "phase": "coverage-fix",
   "per_item": true,
   "skippable": "deferred",
   "group": "cover",
   "included_from": "cover"
  },
  {
   "id": "cover_review",
   "kind": "agent",
   "name": "review the coverage test: assertions lens",
   "agent": "lens-reviewer",
   "model": "default",
   "phase": "coverage-fix",
   "back": "cover_write",
   "lock": true,
   "per_item": true,
   "instructions": "When the item's decision is delete: is the deleted code really unreachable? Look for callers, routes, reflection, configuration, scheduled jobs and event handlers that reach it; if anything can, that is blocking.",
   "rounds": 2,
   "skippable": "deferred",
   "group": "cover",
   "included_from": "cover"
  },
  {
   "id": "cover_commit",
   "kind": "code",
   "name": "coverage commit",
   "phase": "coverage-fix",
   "action": "commit",
   "back": "cover_write",
   "lock": true,
   "per_item": true,
   "skippable": "deferred",
   "group": "cover",
   "included_from": "cover"
  },
  {
   "id": "cover_remeasure",
   "kind": "code",
   "name": "measure again",
   "phase": "coverage-fix",
   "action": "verify_coverage",
   "lock": true,
   "soft": true,
   "skippable": "deferred",
   "group": "cover",
   "included_from": "cover"
  },
  {
   "id": "cover_covered",
   "kind": "branch",
   "name": "coverage passes",
   "phase": "coverage-fix",
   "no": "cover_decide",
   "when": {
    "marker": "RESULT",
    "step": "cover_remeasure",
    "equals": "pass"
   },
   "rounds": 2,
   "skippable": "deferred",
   "group": "cover",
   "included_from": "cover"
  },
  {
   "id": "cover_report",
   "kind": "code",
   "name": "coverage verdict",
   "phase": "coverage-fix",
   "action": "coverage_report",
   "skippable": "deferred",
   "group": "cover",
   "included_from": "cover"
  },
  {
   "id": "deps",
   "kind": "code",
   "name": "verify deps",
   "phase": "ship",
   "action": "verify_deps",
   "skippable": "deferred"
  },
  {
   "id": "audit",
   "kind": "code",
   "name": "audit",
   "phase": "ship",
   "action": "audit",
   "lock": true
  },
  {
   "id": "trace",
   "kind": "code",
   "name": "trace --strict",
   "phase": "ship",
   "action": "trace_strict",
   "lock": true
  },
  {
   "id": "lenses",
   "kind": "code",
   "name": "review lenses",
   "phase": "ship",
   "action": "review_lenses",
   "skippable": "optional",
   "group": "reviewers"
  },
  {
   "id": "review",
   "kind": "parallel",
   "name": "ship review, one lens each",
   "agent": "lens-reviewer",
   "model": "default",
   "phase": "ship",
   "from": "review_lenses",
   "rounds": 2,
   "redo": "verify",
   "skippable": "optional",
   "group": "reviewers"
  },
  {
   "id": "spec_walk",
   "kind": "agent",
   "name": "walk the diff against the spec: name behaviour no criterion asks for",
   "agent": "lens-reviewer",
   "model": "default",
   "phase": "ship",
   "when": {
    "state": "spec"
   },
   "rounds": 2,
   "redo": "verify",
   "skippable": "optional"
  },
  {
   "id": "final_review",
   "kind": "gate",
   "name": "final review",
   "phase": "final-review",
   "back": "verify_fix",
   "lock": true,
   "report": "verdicts"
  },
  {
   "id": "memory_plan",
   "kind": "code",
   "name": "is the knowledge base stale?",
   "phase": "memory",
   "action": "memory_plan"
  },
  {
   "id": "memory_gate",
   "kind": "gate",
   "name": "update the knowledge base?",
   "phase": "memory",
   "when": {
    "data": "memory_plan.ask",
    "equals": "yes"
   },
   "choices": {
    "update": "memory",
    "skip": "memory_skip"
   }
  },
  {
   "id": "memory_skip",
   "kind": "code",
   "name": "skip the knowledge update",
   "phase": "memory",
   "action": "memory_skip",
   "when": {
    "data": "memory_plan.ask",
    "equals": "yes"
   },
   "then": "memory_check"
  },
  {
   "id": "memory",
   "kind": "agent",
   "name": "knowledge update",
   "agent": "librarian",
   "model": "default",
   "phase": "memory",
   "when": {
    "data": "memory_plan.run",
    "equals": "yes"
   },
   "instructions": "Update only these sections, and in them only the claims that cite the files listed (they changed since the last knowledge check). Re-read those files, fix or remove what is no longer true, add what this branch makes worth knowing, and keep every other line as it is. A section listed as not written yet is written from the code.\n{{data.memory_plan.text}}"
  },
  {
   "id": "memory_check",
   "kind": "code",
   "name": "knowledge check",
   "phase": "memory",
   "action": "knowledge_check",
   "when": {
    "data": "memory_plan.check",
    "equals": "yes"
   }
  },
  {
   "id": "memory_commit",
   "kind": "code",
   "name": "commit memory",
   "phase": "memory",
   "action": "commit",
   "when": {
    "data": "memory_plan.run",
    "equals": "yes"
   }
  },
  {
   "id": "pr",
   "kind": "code",
   "name": "PR body",
   "phase": "close",
   "action": "pr"
  },
  {
   "id": "pr_gate",
   "kind": "gate",
   "name": "open the PR",
   "phase": "close",
   "lock": true
  },
  {
   "id": "open_pr",
   "kind": "code",
   "name": "open the PR (never pushes)",
   "phase": "close",
   "action": "open_pr"
  }
 ],
 "expect": {
  "main": [
   "plan",
   "doc_updates",
   "doc_updates_commit",
   "verify_fix",
   "verify_fix_commit",
   "verify",
   "lint",
   "ci",
   "release",
   "cover_measure",
   "cover_measured",
   "cover_measure_failed",
   "cover_needs_work",
   "cover_no_reports",
   "cover_decide",
   "cover_write",
   "cover_review",
   "cover_commit",
   "cover_remeasure",
   "cover_covered",
   "cover_report",
   "deps",
   "audit",
   "trace",
   "lenses",
   "review",
   "spec_walk",
   "final_review",
   "memory_plan",
   "memory_gate",
   "memory",
